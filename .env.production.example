# AutoPost — Production Environment Variables
# Copy this file to .env and fill in real values

# === Auth ===
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_SECRET_64_CHARS
# Your domain (with https)
BETTER_AUTH_URL=https://your-domain.com

# === Encryption ===
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_RANDOM_HEX_64_CHARS

# === n8n Integration (optional) ===
# Generate: openssl rand -hex 24
N8N_API_KEY=CHANGE_ME_RANDOM_HEX_48_CHARS

# === Facebook App ===
# Get from https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# === AI Content Generation ===
# OpenAI-compatible API endpoint (include /v1 if needed)
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key
AI_MODEL=gpt-4o-mini

# === Production ===
NODE_ENV=production
PORT=3000
