# AutoPost — production (VPS / pm2)
# Copy: cp .env.production.example .env
# Redirect OAuth Facebook: {BETTER_AUTH_URL}/api/auth/facebook/callback

# === Auth (bắt buộc) ===
BETTER_AUTH_SECRET=                    # openssl rand -hex 32
BETTER_AUTH_URL=https://post.example.com
REGISTRATION_GATE_USER=webmaster
REGISTRATION_GATE_PASSWORD=devcode15

# === Encryption — token Page/App trong DB (bắt buộc, 64 ký tự hex) ===
ENCRYPTION_KEY=                        # openssl rand -hex 32 — đổi key = token cũ không giải mã được

# === Server ===
NODE_ENV=production
PORT=3100

# === Facebook App (tuỳ chọn — khuyến nghị khai báo trong UI /apps) ===
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# === n8n (tuỳ chọn — /api/posts/due, publish) ===
# N8N_API_KEY=                         # openssl rand -hex 24

# === AI generate (tuỳ chọn) ===
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# === yt-dlp / ffmpeg (tuỳ chọn — pm2 thường set YT_DLP_PATH trong ecosystem.config.js) ===
# YT_DLP_PATH=/var/www/auto-post/.venv/bin/yt-dlp
# YT_DLP_COOKIES_FILE=/path/to/cookies.txt
# FFMPEG_PATH=

# === Cài đặt trên VPS: tránh postinstall tải yt-dlp từ GitHub ===
YOUTUBE_DL_SKIP_DOWNLOAD=1
