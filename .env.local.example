# AutoPost — local dev (Windows / macOS / Linux)
# install-local.bat hoặc: cp .env.local.example .env

# === Auth ===
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# === Encryption (Facebook tokens trong DB, 64 hex) ===
ENCRYPTION_KEY=

# === Server ===
NODE_ENV=development
PORT=3000

# === Facebook (tuỳ chọn — thường khai báo trong /apps) ===
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# === n8n (tuỳ chọn) ===
# N8N_API_KEY=

# === AI (tuỳ chọn) ===
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Redirect OAuth Facebook: {BETTER_AUTH_URL}/api/auth/facebook/callback
